  "@@_EVENT_REMINDERS": "=== Event reminders (PROD-2525 T-K3) ===",
  "eventDetailReminderLabel": "Set reminder",
  "reminderPickerTitle": "Remind me about this",
  "reminderPickerSubtitle": "Pick when you want Soko to nudge you before the event starts.",
  "reminderPickerSubtitleWithExisting": "Tap a highlighted reminder to remove it, or add another.",
  "reminderPickerWebMobileOnlyHint": "Reminders are delivered to your iOS or Android app.",
  "@reminderPickerWebMobileOnlyHint": { "description": "Web-only meta-hint inside the event reminder picker sheet. Tells the user the reminder will arrive on their mobile device (iOS/Android), since web push is not yet implemented. Backend delivery is user-scoped (FCM fanout), so a reminder created on web genuinely fires on every registered mobile device for the same user." },
  "reminderPickerOccurrencesLabel": "Select the event date",
  "@reminderPickerOccurrencesLabel": { "description": "Section heading above the occurrence chip row in the reminder picker (multi-select). Only renders when the event has 2+ upcoming occurrences. The chips beneath are toggleable — the user can pick more than one date and the offset chips below will apply to every active occurrence." },
  "reminderPickerOffsetsLabel": "When do you want to be reminded?",
  "@reminderPickerOffsetsLabel": { "description": "Section heading above the offset chip row in the reminder picker (15 min · 30 min · 1h · 1 day · 1 week). Always renders, including the single-occurrence case." },
  "reminderPreviewLinePrefix": "Event",
  "@reminderPreviewLinePrefix": { "description": "Fixed prefix word that opens every line of the reminder picker preview list — e.g. 'Event Sat (day 22) at 6pm: 30 min before'. Renders once per occurrence group. PT/PT-BR: 'Evento'. EN: 'Event'." },
  "reminderPreviewTimeConnector": "at",
  "@reminderPreviewTimeConnector": { "description": "Locale-aware connector word between an occurrence date and its time-of-day inside the reminder picker preview — e.g. 'Sat (day 22) [at] 6pm'. PT/PT-BR: 'às'. EN: 'at'." },
  "reminderPreviewDayParenthetical": "(day {day})",
  "@reminderPreviewDayParenthetical": {
    "description": "Parenthetical day-of-month clarifier used after the short weekday in the reminder picker preview — e.g. 'Sat (day 22) at 6pm'. EN form uses a cardinal day to avoid ordinal pluralisation complexity. PT/PT-BR: '(dia {day})'. EN: '(day {day})'.",
    "placeholders": {
      "day": {
        "type": "int",
        "example": "22"
      }
    }
  },
  "myRemindersButtonTooltip": "Your reminders",
  "@myRemindersButtonTooltip": { "description": "Tooltip on the small bell-icon button that opens the 'My reminders' bottom sheet. Mounted next to the Inbox on the Discovery end-of-feed action row and next to the create-zine pill on the Yours action bar." },
  "myRemindersSheetTitle": "Your reminders",
  "@myRemindersSheetTitle": { "description": "Header title of the 'My reminders' bottom sheet — lists every event the user has at least one pending reminder on." },
  "myRemindersSheetEmpty": "You don't have any reminders set yet. Tap the bell on an event to add one.",
  "@myRemindersSheetEmpty": { "description": "Empty-state copy in the 'My reminders' sheet when the user has no pending reminders." },
  "myRemindersSheetError": "Couldn't load your reminders.",
  "@myRemindersSheetError": { "description": "Error-state copy in the 'My reminders' sheet when the GET /api/v1/app/users/me/events-with-reminders call fails. Paired with a retry button." },
  "myRemindersSheetRetry": "Try again",
  "@myRemindersSheetRetry": { "description": "Retry button label below the error-state copy in the 'My reminders' sheet." },
  "myRemindersSheetCountSummary": "{count, plural, =1{1 reminder} other{{count} reminders}}",
  "@myRemindersSheetCountSummary": {
    "description": "Per-row subtitle prefix in the 'My reminders' sheet — pluralised count of pending reminders the user has on that event. Concatenated with `myRemindersSheetNextLine` to form '3 reminders · next Sat 6pm'.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "myRemindersSheetNextLine": "next {when}",
  "@myRemindersSheetNextLine": {
    "description": "Per-row subtitle suffix in the 'My reminders' sheet — describes the soonest pending reminder for that event. `when` is the result of `formatEventWhen` (e.g. 'Sat, 6pm', 'Hoje, 18h'). Concatenated after `myRemindersSheetCountSummary` with ' · ' separator.",
    "placeholders": {
      "when": {
        "type": "String",
        "example": "Sat, 6pm"
      }
    }
  },
  "@reminderPickerSubtitleWithExisting": { "description": "Subtitle shown in the reminder picker when the user already has at least one pending reminder for the selected occurrence — signposts that the highlighted (pink) chips are tap-to-remove affordances. Replaces the default subtitle dynamically based on _existingByOffset." },
  "reminderPickerWillRemindPrefix": "I'll remind you ",
  "@reminderPickerWillRemindPrefix": { "description": "Leading copy for the picker's preview sentence (e.g. 'I'll remind you 25 jun 17h, 1 jul 17h and 2 jul 16h.'). The fire-time labels are rendered as bold inline spans by the picker; the trailing period is appended in code. Keep the trailing space so the next bold span attaches cleanly." },
  "reminderPickerCurrentlySetPrefix": "Currently set: ",
  "@reminderPickerCurrentlySetPrefix": { "description": "Leading copy for the picker's preview sentence when the user opens it on a filled bell and has NOT yet edited anything — the same bold enumeration that the 'I'll remind you' prefix carries, but framed as a description of the current saved state instead of pending writes. Swaps with `reminderPickerWillRemindPrefix` based on the diff state. Keep the trailing space so the bold span attaches cleanly." },
  "naturalListAnd": "and",
  "@naturalListAnd": { "description": "Locale-aware connector word for natural list joins (e.g. 'a, b and c'). Used wherever the app glues a list of items into a sentence-shaped string." },
