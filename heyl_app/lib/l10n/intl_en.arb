  "privacyPolicySection3S32Anonymized": "Whenever possible, data used for improvement is anonymized or pseudonymized.",
  "privacyPolicySection3S33Title": "3.3 Communications",
  "privacyPolicySection3S33Purpose": "Purpose",
  "privacyPolicySection3S33PurposeRespond": "Respond to your requests",
