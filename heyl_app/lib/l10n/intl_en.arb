  "@reminderPickerSetToast": { "description": "Success toast shown when the user's save resulted in only POSTs (no DELETEs) — they added one or more reminders without removing any. Replaces the muted 'Reminders updated' for the celebratory set-a-new-reminder moment." },
  "reminderPickerRemovedToast": "Reminder removed",
  "@reminderPickerRemovedToast": { "description": "Success toast shown when the user's save resulted in only DELETEs (no POSTs) — they removed one or more reminders. Distinct from the set-toast so the user gets clear confirmation that the cancel landed." },
  "reminderPickerViewMyReminders": "View active reminders for this event",
  "@reminderPickerViewMyReminders": { "description": "Secondary link in the reminder picker sheet, shown when the event already has saved reminders, that opens the 'My reminders' surface." },
  "myRemindersRemoveReminder": "Remove reminder",
  "@myRemindersRemoveReminder": { "description": "Accessibility label / tooltip on the trash button that removes a single reminder from the 'My reminders' sheet." },
  "reminderPickerSaveError": "Couldn't save your reminders. Try again.",
  "reminderPickerOccurrencePastError": "This event has already started. You can't set a reminder for it.",
  "@reminderPickerOccurrencePastError": { "description": "Toast shown when the user tries to save a reminder for an occurrence whose start_at is in the past. Backend rejects with 422; we bail out client-side to give a clearer message." },
  "reminderPickerTooCloseToast": "Cutting it close! No point reminding you at this hour.",
  "@reminderPickerTooCloseToast": { "description": "Cheeky toast shown when the user taps the reminder icon on an event that's still upcoming but the soonest occurrence is within the smallest preset reminder window (15 min). Fires when the event is coming up too soon to set a useful reminder. Voice matches the other reminder toasts (friendly, conversational)." },
