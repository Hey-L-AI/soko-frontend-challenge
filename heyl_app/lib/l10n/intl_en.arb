  "privacyPolicySection3S33NoMarketing": "Soko does not send third-party marketing communications.",
  "privacyPolicySection3S34Title": "3.4 Marketing Measurement",
  "privacyPolicySection3S34Purpose": "Purpose",
  "privacyPolicySection3S34PurposeMeasure": "Measure the effectiveness of our marketing and attribute new installs to ads we run on third-party platforms (currently Meta/Facebook and Instagram)",
  "privacyPolicySection3S34LegalBasis": "Legal basis",
  "privacyPolicySection3S34LegalConsent": "Explicit consent, given via the iOS App Tracking Transparency prompt. You may withdraw consent at any time in iOS Settings → Privacy & Security → Tracking.",
  "privacyPolicySection3S34NoConsent": "If you decline tracking, we do not collect or share your advertising identifier. Our ads still function, with less precise attribution.",
  "privacyPolicySection4Title": "4. AI Processing and Human Review",
  "privacyPolicySection4Intro": "Soko uses artificial intelligence to understand your messages, generate replies, and help you discover events and places.",
  "privacyPolicySection4ItemAi": "Your messages and limited context are processed by third-party AI providers — OpenAI (chat replies, and understanding Instagram posts you share) and Google (Gemini, for event search) — acting as our processors",
  "privacyPolicySection4ItemData": "We share your message and any image, your recent conversation, your approximate location (city, neighborhood, country), local weather and time, and — for signed-in users — a short summary of your preferences and facts you've asked Soko to remember",
  "privacyPolicySection4ItemNeverShared": "We never share your email, phone number, account ID, device identifier, IP address, payment data, or precise GPS coordinates with these AI providers",
  "privacyPolicySection4ItemHuman": "In limited cases, anonymized data may be reviewed by humans to improve quality, safety, and reliability",
  "privacyPolicySection4ItemNoTraining": "These AI providers do not use your data to train their models and retain it only briefly (up to ~30 days) before deletion",
  "privacyPolicySection5Title": "5. Who We Share Data With",
  "privacyPolicySection5NoSell": "We do not sell personal data.",
  "privacyPolicySection5ShareWith": "We may share data only with:",
  "privacyPolicySection5S51Title": "5.1 Service Providers",
  "privacyPolicySection5S51Intro": "Trusted third parties that help us operate Soko, such as:",
  "privacyPolicySection5S51ItemMessaging": "Messaging platforms (e.g. WhatsApp Business APIs)",
  "privacyPolicySection5S51ItemAi": "AI processing providers — OpenAI and Google (Gemini)",
  "privacyPolicySection5S51ItemWeather": "OpenWeatherMap — receives your location coordinates to provide local weather",
  "privacyPolicySection5S51ItemBackgroundAi": "Anthropic (Claude) — used only for background content processing (such as enriching event listings), never your chat messages",
  "privacyPolicySection5S51ItemCloud": "Cloud hosting, analytics, and monitoring services",
  "privacyPolicySection5S51ItemAdvertising": "Advertising and attribution partners (currently Meta/Facebook) — used only on mobile, only when you grant tracking permission, and only to measure marketing effectiveness",
  "privacyPolicySection5S51Instructions": "These providers process data only under our instructions and confidentiality obligations, and are bound to provide a level of data protection equivalent to our own.",
  "privacyPolicySection5S51AdvertisingNote": "Unlike our other service providers, advertising and attribution partners (currently Meta) may act as independent controllers of the data they receive, under their own privacy policies.",
  "privacyPolicySection5S52Title": "5.2 Legal and Safety Obligations",
  "privacyPolicySection5S52Intro": "We may disclose data where required to:",
  "privacyPolicySection5S52ItemComply": "Comply with applicable law",
  "privacyPolicySection5S52ItemRespond": "Respond to lawful requests from authorities",
  "privacyPolicySection5S52ItemProtect": "Protect the rights, safety, or integrity of users or Soko",
  "privacyPolicySection5S53Title": "5.3 Business Transfers",
  "privacyPolicySection5S53Content": "If Soko is involved in a merger, acquisition, or restructuring, personal data may be transferred subject to appropriate legal safeguards.",
  "privacyPolicySection6Title": "6. International Data Transfers",
  "privacyPolicySection6Content1": "Your data may be processed outside your country of residence.",
  "privacyPolicySection6Content2": "Where required, we apply appropriate safeguards, including contractual protections and providers that comply with EU data protection standards.",
  "privacyPolicySection7Title": "7. Data Retention",
  "privacyPolicySection7Intro": "We retain personal data only for as long as necessary to provide the Service or comply with legal obligations.",
  "privacyPolicySection7ItemActive": "Active conversation data is retained while you use Soko",
  "privacyPolicySection7ItemInactive": "Inactive data may be deleted or anonymized after a reasonable period",
  "privacyPolicySection7ItemDeletion": "You may request deletion at any time",
  "privacyPolicySection8Title": "8. Your Rights",
  "privacyPolicySection8S81Title": "8.1 European Union (GDPR)",
  "privacyPolicySection8S81Intro": "If you are in the EU, you have the right to:",
  "privacyPolicySection8S81ItemAccess": "Access your personal data",
  "privacyPolicySection8S81ItemCorrect": "Correct inaccurate or incomplete data",
  "privacyPolicySection8S81ItemDelete": "Request deletion",
  "privacyPolicySection8S81ItemRestrict": "Restrict or object to processing",
  "privacyPolicySection8S81ItemPortability": "Request data portability",
  "privacyPolicySection8S81ItemWithdraw": "Withdraw consent at any time",
  "privacyPolicySection8S81Requests": "Requests can be sent to",
  "privacyPolicySection8S81Complaint": "You may also lodge a complaint with your local data protection authority.",
  "privacyPolicySection8S82Title": "8.2 Other Jurisdictions",
  "privacyPolicySection8S82Content": "If you are outside the EU, we will respect applicable local data protection rights and respond to requests in good faith.",
  "privacyPolicySection9Title": "9. Cookies and Tracking",
  "privacyPolicySection9Content1": "Soko operates primarily through conversational interfaces.",
  "privacyPolicySection9Content2": "We do not use traditional website cookies or cross-site tracking on our web app. Mobile app tracking is described below.",
  "privacyPolicySection9S91Title": "9.1 Mobile App Tracking (iOS)",
  "privacyPolicySection9S91Content1": "On iOS, the system prompts you to allow or deny app tracking. If you allow it, we share your device's advertising identifier (IDFA) with Meta to attribute installs to ads we run on Facebook and Instagram.",
  "privacyPolicySection9S91Content2": "If you deny tracking, the IDFA is not collected or shared. Our ads continue to work, with less precise attribution.",
  "privacyPolicySection9S91Content3": "You can change your choice at any time in iOS Settings → Privacy & Security → Tracking → Soko.",
  "privacyPolicySection10Title": "10. Minors",
  "privacyPolicySection10Content1": "Soko is not intended for children under 13.",
  "privacyPolicySection10Content2": "If you believe a minor has provided personal data without appropriate consent, please contact us and we will remove it.",
  "privacyPolicySection11Title": "11. Security",
  "privacyPolicySection11Content": "We apply appropriate technical and organizational measures to protect personal data. No system is fully secure, but we continuously work to safeguard your information.",
  "privacyPolicySection12Title": "12. Changes to This Policy",
  "privacyPolicySection12Content1": "We may update this Privacy Policy from time to time.",
  "privacyPolicySection12Content2": "The \"Last updated\" date reflects the current version. Continued use of Soko means acceptance of the updated policy.",
  "privacyPolicySection13Title": "13. Contact",
  "privacyPolicySection13Privacy": "Privacy questions or requests:",
  "privacyPolicySection13Legal": "Legal matters:",
  "privacyPolicySummaryTitle": "Privacy Policy – Short Summary (Non-Binding)",
  "privacyPolicySummaryCollect": "We collect only what's needed to run Soko",
  "privacyPolicySummaryNoSell": "We don't sell your data",
  "privacyPolicySummaryAi": "AI powers the service, with safeguards in place",
  "privacyPolicySummaryControl": "You control your data and can delete it anytime",
  "privacyPolicySummaryAds": "On mobile, we share limited data with advertising partners (such as Meta) to measure our marketing — you control this in your device settings",
  "privacyPolicySummaryEu": "We follow EU data protection standards",

