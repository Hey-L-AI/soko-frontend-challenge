#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
expected_version="$(tr -d '[:space:]' < "$repo_dir/.flutter-version")"
flutter_command="${FLUTTER_BIN:-flutter}"
actual_version="$("$flutter_command" --version --machine | python3 -c 'import json,sys; print(json.load(sys.stdin)["frameworkVersion"])')"
if [[ "$actual_version" != "$expected_version" ]]; then
  echo "This snapshot uses Flutter $expected_version; found $actual_version." >&2
  echo "Install the pinned SDK or set FLUTTER_BIN to its flutter executable." >&2
  exit 1
fi
cd "$repo_dir/heyl_app"
"$flutter_command" pub get --enforce-lockfile
"$flutter_command" gen-l10n
exec "$flutter_command" run -d chrome --web-port 3001 "$@"
